{
  "name": "mitali-hospital",
  "private": true,
  "version": "1.3.48",
  "description": "تطبيق ويب مستقل لإدارة المستشفى باستخدام Supabase وPostgreSQL",
  "author": "Mitali Hospital",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node tools/dev-server.js",
    "start": "node tools/dev-server.js",
    "build": "node tools/build-config.js && node tools/check-js-syntax.js",
    "check": "node tools/check-js-syntax.js",
    "test:income-form": "node tools/income-form-test.js",
    "test:doctor-payroll": "node tools/doctor-payroll-test.js",
    "test:accounting-consistency": "node tools/accounting-consistency-test.js",
    "test:doctor-departments": "node tools/doctor-departments-test.js",
    "test:dashboard-imaging": "node tools/dashboard-imaging-test.js",
    "test:dashboard-patient-sources": "node tools/dashboard-patient-sources-test.js",
    "test:dashboard-listeners": "node tools/dashboard-listeners-test.js",
    "test:settings-after-wipe": "node tools/settings-after-wipe-test.js",
    "test:unified-users-page": "node tools/unified-users-page-test.js",
    "test:sync-outbox": "node tools/sync-outbox-test.js",
    "test:sync-scenarios": "node tools/sync-scenarios-test.js",
    "test:sync-delete": "node tools/sync-delete-propagation-test.js",
    "test:snapshot-safety": "node tools/snapshot-safety-test.js",
    "test:visit-delete-income": "node tools/visit-delete-income-test.js",
    "test:visit-page-live": "node tools/visit-page-live-test.js",
    "test:income-delete-cascade": "node tools/income-delete-cascade-test.js",
    "test:visit-period-filter": "node tools/visit-period-filter-test.js",
    "test:page-live-payroll-audit": "node tools/page-live-payroll-audit-test.js",
    "test:visit-window-size": "node tools/visit-window-size-test.js",
    "test:dashboard-no-visits": "node tools/dashboard-no-visits-test.js",
    "test:exact-visits": "node tools/exact-visits-test.js",
    "test:visit-double-save-lock": "node tools/visit-double-save-lock-test.js",
    "test:ledger-visibility-runtime": "node tools/ledger-visibility-test.js",
    "test:ledger-visibility": "node tools/financial-ledger-runtime-test.js",
    "test:visit-income-reconciliation": "node tools/financial-ledger-runtime-test.js",
    "test:storage-mode-restore": "node tools/financial-ledger-runtime-test.js",
    "test:acceptance": "node tools/migration-acceptance-test.js",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win nsis --x64 --publish never",
    "desktop:publish": "electron-builder --win nsis --x64 --publish always",
    "test": "npm run check && npm run test:acceptance && npm run test:income-form && npm run test:doctor-payroll && npm run test:accounting-consistency && npm run test:doctor-departments && npm run test:visit-window-size"
  },
  "dependencies": {
    "express": "^4.21.2",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {},
  "build": {
    "appId": "com.mitali.hospital",
    "productName": "Mitali Hospital",
    "artifactName": "Mitali-Hospital-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "supabase-store.js",
      "supabase-config.js",
      "manifest.json",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "apple-touch-icon.png",
      "favicon-32.png",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "ahmed0soliman6",
      "repo": "mitali-hospital-releases",
      "private": false,
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mitali Hospital"
    }
  }
}
